file_monitor:
  paths:
    - ./watched_dir
  hash_algo: sha256
  baseline_file: ./baseline.json
  alert_on_new: true
  alert_on_deleted: true
  alert_on_modified: true

# Process monitoring
process_monitor:
  allowed_processes:
    - python
    - sshd
    - systemd
    - cron
  check_interval_seconds: 10

# Log monitoring (tail file, match regex patterns considered suspicious)
