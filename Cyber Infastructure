  files:
    - /var/log/auth.log       # adjust to your system or use a test log file
  patterns:
    - 'Failed password'
    - 'authentication failure'
    - 'Invalid user'
  check_interval_seconds: 5

# Port check (for defensive verification; only use on hosts you control)
