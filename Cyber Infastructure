import tempfile
import os
from file_monitor import Baseline
from utils import compute_hash

def test_baseline_roundtrip(tmp_path):
    basefile = tmp_path / "base.json"
    p = tmp_path / "watched"
    p.mkdir()
    f = p / "t.txt"
    f.write_text("v1")
    b = Baseline(str(basefile), algo="sha256")
    # simulate baseline update
    h = compute_hash(str(f), "sha256")
    b.update(str(f), h)
    assert b.get(str(f)) == h
    b.remove(str(f))
    assert b.get(str(f)) is None

# mini-hids

Lightweight Host Intrusion Detection System (HIDS) for learning and basic host monitoring.

## Features
- File integrity monitoring with baseline
- Process monitoring to detect unexpected processes
- Log monitoring (tail + regex alerting)
- Limited port check (for verifying services on systems you control)
- Local alerting to console + log file (mini-hids.log)

